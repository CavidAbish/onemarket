<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.onemarket.presentation.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_homeFragment_to_categoryProductsFragment" app:destination="@id/categoryProductsFragment" />
        <action android:id="@+id/action_homeFragment_to_productDetailFragment" app:destination="@id/productDetailFragment" />
        <action android:id="@+id/action_homeFragment_to_searchFragment" app:destination="@id/searchFragment" />
        <action android:id="@+id/action_homeFragment_to_cityFragment" app:destination="@id/cityFragment" />
        <action android:id="@+id/action_homeFragment_to_notificationsFragment" app:destination="@id/notificationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.example.onemarket.presentation.catalog.CatalogFragment"
        android:label="fragment_catalog"
        tools:layout="@layout/fragment_catalog">
        <action android:id="@+id/action_catalogFragment_to_categoryProductsFragment" app:destination="@id/categoryProductsFragment" />
        <action android:id="@+id/action_catalogFragment_to_searchFragment" app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.onemarket.presentation.favorites.FavoritesFragment"
        android:label="fragment_favorites"
        tools:layout="@layout/fragment_favorites">
        <action android:id="@+id/action_favoritesFragment_to_productDetailFragment" app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.onemarket.presentation.cart.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart">
        <action android:id="@+id/action_cartFragment_to_productDetailFragment" app:destination="@id/productDetailFragment" />
        <action android:id="@+id/action_cartFragment_to_deliveryFragment" app:destination="@id/deliveryFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.onemarket.presentation.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">
        <action android:id="@+id/action_profileFragment_to_loginFragment" app:destination="@id/loginFragment" />
        <action android:id="@+id/action_profileFragment_to_cityFragment" app:destination="@id/cityFragment" />
        <action android:id="@+id/action_profileFragment_to_myOrdersFragment" app:destination="@id/myOrdersFragment" />
        <action android:id="@+id/action_profileFragment_to_pickupListFragment" app:destination="@id/pickupListFragment" />
        <action android:id="@+id/action_profileFragment_to_creditApplicationsFragment" app:destination="@id/creditApplicationsFragment" />
        <action android:id="@+id/action_profileFragment_to_notificationsFragment" app:destination="@id/notificationsFragment" />
        <action android:id="@+id/action_profileFragment_to_promoCodesFragment" app:destination="@id/promoCodesFragment" />
        <action android:id="@+id/action_profileFragment_to_reviewsFragment" app:destination="@id/reviewsFragment" />
        <action android:id="@+id/action_profileFragment_to_extraServicesFragment" app:destination="@id/extraServicesFragment" />
        <action android:id="@+id/action_profileFragment_to_birIdProfileFragment" app:destination="@id/birIdProfileFragment" />
        <action android:id="@+id/action_profileFragment_to_faqFragment" app:destination="@id/faqFragment" />
        <action android:id="@+id/action_profileFragment_to_deliveryPaymentFragment" app:destination="@id/deliveryPaymentFragment" />
        <action android:id="@+id/action_profileFragment_to_savedAddressesFragment" app:destination="@id/savedAddressesFragment" />
        <action android:id="@+id/action_profileFragment_to_myCardsFragment" app:destination="@id/myCardsFragment" />
        <action android:id="@+id/action_profileFragment_to_deleteAccountFragment" app:destination="@id/deleteAccountFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.onemarket.presentation.login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action android:id="@+id/action_loginFragment_to_otpFragment" app:destination="@id/otpFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="com.example.onemarket.presentation.login.OtpFragment"
        android:label="fragment_otp"
        tools:layout="@layout/fragment_otp">
        <argument android:name="phone" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/cityFragment"
        android:name="com.example.onemarket.presentation.city.CityFragment"
        android:label="fragment_city"
        tools:layout="@layout/fragment_city" />

    <fragment
        android:id="@+id/deliveryFragment"
        android:name="com.example.onemarket.presentation.delivery.DeliveryFragment"
        android:label="fragment_delivery"
        tools:layout="@layout/fragment_delivery">
        <argument android:name="isCredit" app:argType="boolean" android:defaultValue="false" />
        <action android:id="@+id/action_deliveryFragment_to_cityFragment" app:destination="@id/cityFragment" />
        <action android:id="@+id/action_deliveryFragment_to_mapPickerFragment" app:destination="@id/mapPickerFragment" />
        <action android:id="@+id/action_deliveryFragment_to_orderSummaryFragment" app:destination="@id/orderSummaryFragment" />
        <action android:id="@+id/action_deliveryFragment_to_pickupMapFragment" app:destination="@id/pickupMapFragment" />
    </fragment>

    <fragment
        android:id="@+id/pickupMapFragment"
        android:name="com.example.onemarket.presentation.delivery.PickupMapFragment"
        android:label="fragment_pickup_map"
        tools:layout="@layout/fragment_pickup_map">
        <argument android:name="pointId" app:argType="integer" android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/pickupListFragment"
        android:name="com.example.onemarket.presentation.profile.PickupListFragment"
        android:label="fragment_pickup_list"
        tools:layout="@layout/fragment_pickup_list">
        <action android:id="@+id/action_pickupListFragment_to_pickupMapFragment" app:destination="@id/pickupMapFragment" />
    </fragment>

    <fragment
        android:id="@+id/mapPickerFragment"
        android:name="com.example.onemarket.presentation.delivery.MapPickerFragment"
        android:label="fragment_map_picker"
        tools:layout="@layout/fragment_map_picker" />

    <fragment
        android:id="@+id/orderSummaryFragment"
        android:name="com.example.onemarket.presentation.delivery.OrderSummaryFragment"
        android:label="fragment_order_summary"
        tools:layout="@layout/fragment_order_summary">
        <argument android:name="isCredit" app:argType="boolean" android:defaultValue="false" />
        <action android:id="@+id/action_orderSummaryFragment_to_paymentFragment" app:destination="@id/paymentFragment" />
        <action android:id="@+id/action_orderSummaryFragment_to_paymentMethodFragment" app:destination="@id/paymentMethodFragment" />
        <action android:id="@+id/action_orderSummaryFragment_to_myOrdersFragment" app:destination="@id/myOrdersFragment"
            app:popUpTo="@id/cartFragment" app:popUpToInclusive="true" />
        <action android:id="@+id/action_orderSummaryFragment_to_creditApplicationsFragment"
            app:destination="@id/creditApplicationsFragment"
            app:popUpTo="@id/cartFragment" app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/creditApplicationsFragment"
        android:name="com.example.onemarket.presentation.profile.CreditApplicationsFragment"
        android:label="fragment_credit_applications"
        tools:layout="@layout/fragment_credit_applications">
        <action android:id="@+id/action_creditApplicationsFragment_to_creditDetailFragment" app:destination="@id/creditDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/creditDetailFragment"
        android:name="com.example.onemarket.presentation.profile.CreditDetailFragment"
        android:label="fragment_credit_detail"
        tools:layout="@layout/fragment_credit_detail">
        <argument android:name="applicationId" app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/paymentMethodFragment"
        android:name="com.example.onemarket.presentation.delivery.PaymentMethodFragment"
        android:label="fragment_payment_method"
        tools:layout="@layout/fragment_payment_method">
        <argument android:name="currentMethod" app:argType="string" android:defaultValue="ONLINE" />
    </fragment>

    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.example.onemarket.presentation.delivery.PaymentFragment"
        android:label="fragment_payment"
        tools:layout="@layout/fragment_payment">
        <argument android:name="amount" app:argType="float" />
        <argument android:name="installmentMonths" app:argType="integer" android:defaultValue="0" />
        <action android:id="@+id/action_paymentFragment_to_paymentFailedFragment" app:destination="@id/paymentFailedFragment" />
        <action android:id="@+id/action_paymentFragment_to_threeDSecureFragment" app:destination="@id/threeDSecureFragment" />
    </fragment>

    <fragment
        android:id="@+id/threeDSecureFragment"
        android:name="com.example.onemarket.presentation.delivery.ThreeDSecureFragment"
        android:label="fragment_3d_secure"
        tools:layout="@layout/fragment_3d_secure">
        <argument android:name="amount" app:argType="float" />
        <argument android:name="installmentMonths" app:argType="integer" android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/paymentFailedFragment"
        android:name="com.example.onemarket.presentation.delivery.PaymentFailedFragment"
        android:label="fragment_payment_failed"
        tools:layout="@layout/fragment_payment_failed" />

    <fragment
        android:id="@+id/categoryProductsFragment"
        android:name="com.example.onemarket.presentation.category.CategoryProductsFragment"
        android:label="fragment_category_products"
        tools:layout="@layout/fragment_category_products">
        <argument android:name="slug" app:argType="string" />
        <argument android:name="categoryName" app:argType="string" />
        <action android:id="@+id/action_categoryProductsFragment_to_productDetailFragment" app:destination="@id/productDetailFragment" />
        <action android:id="@+id/action_categoryProductsFragment_to_searchFragment" app:destination="@id/searchFragment" />
        <action android:id="@+id/action_categoryProductsFragment_to_filterFragment" app:destination="@id/filterFragment" />
        <action android:id="@+id/action_categoryProductsFragment_self"
            app:destination="@id/categoryProductsFragment"
            app:popUpTo="@id/categoryProductsFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/filterFragment"
        android:name="com.example.onemarket.presentation.category.FilterFragment"
        android:label="fragment_filter"
        tools:layout="@layout/fragment_filter">
        <argument android:name="filterState"
            app:argType="com.example.onemarket.presentation.category.FilterState" />
        <argument android:name="categoryName" app:argType="string" android:defaultValue="" />
        <argument android:name="availableBrands" app:argType="string" android:defaultValue="" />
        <argument android:name="productCount" app:argType="integer" android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.onemarket.presentation.detail.ProductDetailFragment"
        android:label="fragment_product_detail"
        tools:layout="@layout/fragment_product_detail">
        <argument android:name="product" app:argType="com.example.onemarket.domain.model.ProductModel" />
        <action android:id="@+id/action_productDetailFragment_self" app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.onemarket.presentation.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search">
        <action android:id="@+id/action_searchFragment_to_productDetailFragment" app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/myOrdersFragment"
        android:name="com.example.onemarket.presentation.profile.MyOrdersFragment"
        android:label="fragment_my_orders"
        tools:layout="@layout/fragment_my_orders">
        <action android:id="@+id/action_myOrdersFragment_to_orderDetailFragment" app:destination="@id/orderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.example.onemarket.presentation.profile.OrderDetailFragment"
        android:label="fragment_order_detail"
        tools:layout="@layout/fragment_order_detail">
        <argument android:name="orderId" app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.onemarket.presentation.notifications.NotificationsFragment"
        android:label="fragment_notifications"
        tools:layout="@layout/fragment_notifications">
        <action android:id="@+id/action_notificationsFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
        <action android:id="@+id/action_notificationsFragment_to_creditDetailFragment"
            app:destination="@id/creditDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/promoCodesFragment"
        android:name="com.example.onemarket.presentation.profile.PromoCodesFragment"
        android:label="fragment_promo_codes"
        tools:layout="@layout/fragment_promo_codes" />

    <fragment
        android:id="@+id/reviewsFragment"
        android:name="com.example.onemarket.presentation.profile.ReviewsFragment"
        android:label="fragment_reviews"
        tools:layout="@layout/fragment_reviews" />

    <fragment
        android:id="@+id/extraServicesFragment"
        android:name="com.example.onemarket.presentation.profile.ExtraServicesFragment"
        android:label="fragment_extra_services"
        tools:layout="@layout/fragment_extra_services" />

    <fragment
        android:id="@+id/birIdProfileFragment"
        android:name="com.example.onemarket.presentation.profile.BirIdProfileFragment"
        android:label="fragment_bir_id_profile"
        tools:layout="@layout/fragment_bir_id_profile" />

    <fragment
        android:id="@+id/faqFragment"
        android:name="com.example.onemarket.presentation.profile.FaqFragment"
        android:label="fragment_faq"
        tools:layout="@layout/fragment_faq" />

    <fragment
        android:id="@+id/deliveryPaymentFragment"
        android:name="com.example.onemarket.presentation.profile.DeliveryPaymentFragment"
        android:label="fragment_delivery_payment"
        tools:layout="@layout/fragment_delivery_payment" />

    <fragment
        android:id="@+id/savedAddressesFragment"
        android:name="com.example.onemarket.presentation.profile.SavedAddressesFragment"
        android:label="fragment_saved_addresses"
        tools:layout="@layout/fragment_saved_addresses">
        <action
            android:id="@+id/action_savedAddressesFragment_to_addAddressFragment"
            app:destination="@id/addAddressFragment" />
    </fragment>

    <fragment
        android:id="@+id/addAddressFragment"
        android:name="com.example.onemarket.presentation.profile.AddAddressFragment"
        android:label="fragment_add_address"
        tools:layout="@layout/fragment_add_address">
        <argument
            android:name="addressId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_addAddressFragment_to_mapPickerFragment"
            app:destination="@id/mapPickerFragment" />
    </fragment>

    <fragment
        android:id="@+id/myCardsFragment"
        android:name="com.example.onemarket.presentation.profile.MyCardsFragment"
        android:label="fragment_my_cards"
        tools:layout="@layout/fragment_my_cards">
        <action android:id="@+id/action_myCardsFragment_to_addCardFragment" app:destination="@id/addCardFragment" />
        <action android:id="@+id/action_myCardsFragment_to_cardDetailFragment" app:destination="@id/cardDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/addCardFragment"
        android:name="com.example.onemarket.presentation.profile.AddCardFragment"
        android:label="fragment_add_card"
        tools:layout="@layout/fragment_add_card" />

    <fragment
        android:id="@+id/cardDetailFragment"
        android:name="com.example.onemarket.presentation.profile.CardDetailFragment"
        android:label="fragment_card_detail"
        tools:layout="@layout/fragment_card_detail">
        <argument android:name="cardId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/deleteAccountFragment"
        android:name="com.example.onemarket.presentation.profile.DeleteAccountFragment"
        android:label="fragment_delete_account"
        tools:layout="@layout/fragment_delete_account">
        <action android:id="@+id/action_deleteAccountFragment_to_deleteAccountOtpFragment"
            app:destination="@id/deleteAccountOtpFragment" />
    </fragment>

    <fragment
        android:id="@+id/deleteAccountOtpFragment"
        android:name="com.example.onemarket.presentation.profile.DeleteAccountOtpFragment"
        android:label="fragment_delete_account_otp"
        tools:layout="@layout/fragment_delete_account_otp">
        <argument android:name="phone" app:argType="string" />
    </fragment>

</navigation>
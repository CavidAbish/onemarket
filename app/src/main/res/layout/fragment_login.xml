<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            android:padding="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Əlaqə nömrənizi qeyd edin"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#E91E8C" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/tvTerms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Telefon nömrəsi label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telefon nömrəsi"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <!-- Ölkə kodu + nömrə -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Ölkə seçimi düyməsi -->
            <LinearLayout
                android:id="@+id/btnCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_back"
                    android:rotation="270"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/tvCountryFlag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🇦🇿"
                    android:textSize="22sp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvCountryCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+994"
                    android:textSize="16sp"
                    android:textColor="#1A1A1A" />

            </LinearLayout>

            <!-- Nömrə -->
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="XX XXX XX XX"
                android:textSize="16sp"
                android:textColor="#1A1A1A"
                android:inputType="phone"
                android:background="@android:color/transparent" />

        </LinearLayout>

        <!-- Alt xətt -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#E91E8C"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- İrəli düyməsi -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="İrəli"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#CCCCCC"
            android:enabled="false"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <!-- və ya -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="və ya"
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Daxil ol düyməsi -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Daxil ol"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#E91E8C"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Şərtlər mətni -->
    <TextView
        android:id="@+id/tvTerms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="Qeydiyyatdan keçərək və ya xidmətdən istifadə etməyə davam edərək, siz avtomatik olaraq istifadəçi razılaşmaları və məxfilik siyasəti ilə razılaşırsınız."
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ölkə seçim dialog overlay -->
    <LinearLayout
        android:id="@+id/countryPickerOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Axtarış -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/btnCloseCountry"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:padding="6dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F2F2F2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_search"
                        android:alpha="0.5" />

                    <EditText
                        android:id="@+id/etCountrySearch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Ölkə axtar"
                        android:textSize="14sp"
                        android:background="@android:color/transparent"
                        android:layout_marginStart="8dp"
                        android:inputType="text"
                        android:singleLine="true" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCountries"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
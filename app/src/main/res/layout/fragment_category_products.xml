<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Top bar: back + search -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            android:padding="6dp"
            android:contentDescription="@string/btn_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_filter_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/home_search_hint"
                android:textSize="14sp"
                android:textColor="#AAAAAA" />

        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner — öz şəklini res/drawable/banner_category.png kimi əlavə et -->
            <ImageView
                android:id="@+id/ivCategoryBanner"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/banner_category"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:clipToOutline="true"
                android:contentDescription="Banner" />

            <!-- Category header: title + count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvCategoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/category_default_title"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/tvProductCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_product_count"
                    android:textSize="12sp"
                    android:textColor="#888888" />

            </LinearLayout>

            <!-- Subcategory horizontal scroll -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSubcategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8"
                android:layout_marginTop="4dp" />

            <!-- Filter bar: horizontal scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:background="#FFFFFF">

                <LinearLayout
                    android:id="@+id/filterBar"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- Sort button -->
                    <LinearLayout
                        android:id="@+id/btnSort"
                        android:layout_width="40dp"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_filter_chip"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sort"
                            android:contentDescription="Sırala" />

                    </LinearLayout>

                    <!-- Filtrlər button -->
                    <FrameLayout
                        android:id="@+id/btnFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:background="@drawable/bg_filter_chip">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_filter_sliders"
                                android:contentDescription="Filtr" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/category_filter_filters"
                                android:textSize="13sp"
                                android:textColor="#333333" />

                        </LinearLayout>

                        <!-- Badge -->
                        <TextView
                            android:id="@+id/tvFilterBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-4dp"
                            android:layout_marginEnd="-4dp"
                            android:background="@drawable/bg_count_pill"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- Brend chip -->
                    <LinearLayout
                        android:id="@+id/chipBrend"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_filter_chip"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvBrendLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/category_filter_brand"
                            android:textSize="13sp"
                            android:textColor="#333333" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_dropdown"
                            android:contentDescription="@null" />

                    </LinearLayout>

                    <!-- Qiymət chip -->
                    <LinearLayout
                        android:id="@+id/chipQiymet"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_filter_chip"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvQiymetLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/category_filter_price"
                            android:textSize="13sp"
                            android:textColor="#333333" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_dropdown"
                            android:contentDescription="@null" />

                    </LinearLayout>

                    <!-- Endirimlə chip -->
                    <LinearLayout
                        android:id="@+id/chipEndiriml"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_filter_chip">

                        <TextView
                            android:id="@+id/tvEndirimlLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/category_filter_discount"
                            android:textSize="13sp"
                            android:textColor="#333333" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Active filter chips (visible only when filters applied) -->
            <HorizontalScrollView
                android:id="@+id/activeFiltersScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:background="#FFFFFF"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llActiveFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewCategoryProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:background="#F5F5F5"
                android:paddingTop="8dp" />

            <LinearLayout
                android:id="@+id/emptyStateView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="72dp"
                android:paddingBottom="72dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:src="@drawable/ic_search"
                    android:tint="#E91E8C"
                    android:padding="24dp"
                    android:background="@drawable/bg_empty_state_circle"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_no_results"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#E91E8C"
                    android:layout_marginTop="22dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_try_other_filters"
                    android:textSize="13sp"
                    android:textColor="#F06292"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

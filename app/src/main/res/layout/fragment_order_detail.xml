<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Top bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:padding="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvOrderNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sifariş №"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/btnCopyHeader" />

        <ImageView
            android:id="@+id/btnCopyHeader"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_copy"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Sifariş statusu kartı -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOrderStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Sifariş"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivStatusIcon" />

                    <!-- Success icon (ödənilib) -->
                    <ImageView
                        android:id="@+id/ivStatusIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_order_success"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Cancelled icon (ləğv edildi) — dairəvi çərçivə + X -->
                    <FrameLayout
                        android:id="@+id/ivStatusCancelled"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_red_light"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_close"
                            android:tint="#F44336" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvOrderDateTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tvOrderStatusTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- Çatdırılma bloku -->
            <androidx.cardview.widget.CardView
                android:id="@+id/deliveryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvDeliveryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Çatdırılma"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:paddingBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_location"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvDeliveryAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A"
                            android:text="Çatdırılma ünvanı" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Sifarişi ləğv et -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <Button
                    android:id="@+id/btnCancelOrder"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Sifarişi ləğv et"
                    android:textColor="#F44336"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </androidx.cardview.widget.CardView>

            <!-- Sifarişin tərkibi -->
            <androidx.cardview.widget.CardView
                android:id="@+id/compositionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCompositionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Sifarişin tərkibi"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/divComposition"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvCompositionTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvSellerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Satıcı:"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/divComposition"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvSellerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OneMarket"
                        android:textSize="13sp"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/divComposition"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/divSeller"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/tvSellerLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/ivProductImage"
                        android:layout_width="60dp"
                        android:layout_height="70dp"
                        android:scaleType="centerCrop"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/divSeller"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvProductTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#1A1A1A"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/divSeller"
                        app:layout_constraintStart_toEndOf="@id/ivProductImage"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvProductPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#E91E8C"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tvProductTitle"
                        app:layout_constraintStart_toEndOf="@id/ivProductImage" />

                    <TextView
                        android:id="@+id/tvProductOldPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginStart="4dp"
                        app:layout_constraintTop_toTopOf="@id/tvProductPrice"
                        app:layout_constraintBottom_toBottomOf="@id/tvProductPrice"
                        app:layout_constraintStart_toEndOf="@id/tvProductPrice" />

                    <TextView
                        android:id="@+id/tvProductQuantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginStart="4dp"
                        app:layout_constraintTop_toTopOf="@id/tvProductPrice"
                        app:layout_constraintBottom_toBottomOf="@id/tvProductPrice"
                        app:layout_constraintStart_toEndOf="@id/tvProductOldPrice" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- Ödəniş məlumatları -->
            <androidx.cardview.widget.CardView
                android:id="@+id/paymentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvPaymentTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ödəniş məlumatları"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Alıcı -->
                    <TextView
                        android:id="@+id/tvBuyerLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Alıcı"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvPaymentTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvBuyerName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tvBuyerLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvBuyerPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tvBuyerName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/divPayment1"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/tvBuyerPhone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Ödəniş üsulu -->
                    <TextView
                        android:id="@+id/tvPaymentMethodLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ödəniş üsulu"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/divPayment1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvPaymentMethod"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tvPaymentMethodLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/divPayment2"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/tvPaymentMethod"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Ödəniş statusu -->
                    <TextView
                        android:id="@+id/tvPaymentStatusLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ödənişin statusu"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/divPayment2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvPaymentStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ödənilib"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tvPaymentStatusLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/divPayment3"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/tvPaymentStatus"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Cəmi -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Cəmi ödəniləcək:"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/divPayment3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tvTotalAmount"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 ₼"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/divPayment3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- Ödənişin detallarını göstər -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowPaymentDetails"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ödənişin detallarını göstər"
                        android:textSize="14sp"
                        android:textColor="#E91E8C"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivArrowDetails" />

                    <ImageView
                        android:id="@+id/ivArrowDetails"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- Dəstək xidməti -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <Button
                    android:id="@+id/btnSupport"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Dəstək xidməti"
                    android:textColor="@color/pink_main"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/ic_support"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:background="@drawable/bg_outline_pink" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

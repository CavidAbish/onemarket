<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sifarişin ödənişi"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A237E" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:padding="4dp" />

    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Başlıq -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sifarişin ödənişi"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="4dp" />

            <!-- Birbank taksit subtitle (GONE by default) -->
            <TextView
                android:id="@+id/tvInstallmentSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- OneMarket loqo -->
            <LinearLayout
                android:id="@+id/llOneMarketLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◇ "
                    android:textSize="22sp"
                    android:textColor="#E91E8C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="onemarket"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#E91E8C" />

            </LinearLayout>

            <!-- BirBank loqo (yalnız taksit ödənişi üçün) -->
            <LinearLayout
                android:id="@+id/llBirbankLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <!-- "b" bloku -->
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="b"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:gravity="center"
                    android:background="#1B2D72" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="birbank"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1B2D72"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="taksit ödənişi"
                        android:textSize="11sp"
                        android:textColor="#888888" />

                </LinearLayout>

            </LinearLayout>

            <!-- Kart məlumatları başlığı -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kart məlumatlarını daxil edin"
                android:textSize="15sp"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="12dp" />

            <!-- Kart nömrəsi — 16 rəqəm -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="#CCCCCC"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCardNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kart nömrəsi"
                    android:inputType="number"
                    android:maxLength="19"
                    android:digits="0123456789 " />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- AY/İL + CVV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:boxStrokeColor="#CCCCCC"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="AY/İL"
                        android:inputType="number"
                        android:maxLength="5" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxStrokeColor="#CCCCCC"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCvv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="CVV2"
                        android:inputType="numberPassword"
                        android:maxLength="3" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Kartı yadda saxlamaq -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <CheckBox
                    android:id="@+id/cbSaveCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E91E8C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kartı yadda saxlamaq"
                    android:textSize="14sp"
                    android:textColor="#1A1A1A"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Ödəniş detalları -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ödəniş detalları"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ödəniş məbləği"
                android:textSize="13sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvPaymentAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 AZN"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp" />

            <!-- Birbank: hissə-hissə ödəniş + ID (GONE by default) -->
            <LinearLayout
                android:id="@+id/installmentDetailRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hissə-hissə ödəniş"
                    android:textSize="13sp"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/tvInstallmentDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 AZN × 3 ay"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ödəniş İD-si"
                    android:textSize="13sp"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/tvPaymentIdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:background="@android:color/transparent" />

            <!-- Ödəniş et -->
            <Button
                android:id="@+id/btnPay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Ödəniş et"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#E91E8C"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <!-- İmtina -->
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="İmtina"
                android:textColor="#E91E8C"
                android:textSize="16sp"
                android:backgroundTint="#FFFFFF"
                app:strokeColor="#E91E8C"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="24dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Bank ikonları -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A7E"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●●"
                    android:textSize="18sp"
                    android:textColor="#E91E8C"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="birbank"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E91E8C" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
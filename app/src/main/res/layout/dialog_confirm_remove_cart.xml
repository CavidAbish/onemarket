<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- X bağla düyməsi -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/btnDialogClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Bağla" />
    </RelativeLayout>

    <!-- Başlıq -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Əminsiniz?"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- Mətn -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Məhsulu silmək istədiyinizdən əminsiniz? Məhsulu seçilmişlər siyahısına əlavə edə bilərsiniz"
        android:textSize="14sp"
        android:textColor="#757575"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:lineSpacingMultiplier="1.3" />

    <!-- Ayırıcı xətt -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- Düymələr -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Seçilmişlər düyməsi -->
        <Button
            android:id="@+id/btnAddToFavorites"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Seçilmişlər"
            android:textColor="#F44336"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@android:color/transparent" />

        <!-- Şaquli ayırıcı -->
        <View
            android:layout_width="1dp"
            android:layout_height="56dp"
            android:background="#E0E0E0" />

        <!-- Sil düyməsi -->
        <Button
            android:id="@+id/btnDeleteConfirm"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Sil"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#F44336"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>

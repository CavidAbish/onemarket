<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Top bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rəylərim"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tab row -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabWriteReview"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Rəy yazmaq"
            android:textSize="13sp"
            android:textColor="#1A237E"
            android:gravity="center"
            android:background="@drawable/bg_chip_selected"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tabMyReviews"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Mənim rəylərim"
            android:textSize="13sp"
            android:textColor="#9E9E9E"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <View
        android:id="@+id/dividerTab"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/tabRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Tab 1: Rəy yazmaq (empty state: truck) ── -->
    <FrameLayout
        android:id="@+id/contentWriteReview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/dividerTab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivTruck"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/ic_empty_truck"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvNoDelivered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Çatdırılmış məhsul yoxdur"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNoDeliveredSub"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:text="Rəy yazmaq üçün əvvəlcə sifariş verin"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnStartShopping"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:text="Alış-verişə başla"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A237E"
                android:stateListAnimator="@null"
                android:layout_gravity="center_horizontal" />

        </LinearLayout>

    </FrameLayout>

    <!-- ── Tab 2: Mənim rəylərim (empty state: chat bubbles) ── -->
    <FrameLayout
        android:id="@+id/contentMyReviews"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dividerTab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/ivChat"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/ic_empty_chat"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvNoReviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rəylərin bizim üçün vacibdir"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNoReviewsSub"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:text="Aldığınız məhsullar haqqında rəyinizi bizimlə bölüşün"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnWriteReview"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:text="Rəy yazmaq"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A237E"
                android:stateListAnimator="@null"
                android:layout_gravity="center_horizontal" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

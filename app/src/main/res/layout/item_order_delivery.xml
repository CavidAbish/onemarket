<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp">

    <!-- Sifariş başlığı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvOrderNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SİFARİŞ 1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvSellerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Satıcı"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Məhsul -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivProductImage"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Məhsul adı"
                    android:textSize="13sp"
                    android:textColor="#1A1A1A"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tvOldPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7.00 ₼"
                        android:textSize="11sp"
                        android:textColor="#AAAAAA" />

                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.38 ₼"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#E91E8C" />

                    <TextView
                        android:id="@+id/tvQuantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 əd"
                        android:textSize="11sp"
                        android:textColor="#888888" />

                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- Kuryerlə çatdırılma -->
            <LinearLayout
                android:id="@+id/optionCourier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kuryerlə çatdırılma"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCourierDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- may, "
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 ₼"
                                android:textSize="13sp"
                                android:textColor="#E91E8C" />

                        </LinearLayout>

                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/radioCourier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E91E8C" />

                </LinearLayout>

                <!-- Seçilmiş ünvan -->
                <TextView
                    android:id="@+id/tvCourierAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <!-- Ünvan əlavə et -->
                <Button
                    android:id="@+id/btnAddAddress"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="Çatdırılma ünvanını əlavə et"
                    android:textColor="#E91E8C"
                    android:textSize="13sp"
                    android:backgroundTint="#FCE4EC"
                    android:visibility="gone"
                    app:cornerRadius="8dp" />

                <!-- Zaman aralıqları -->
                <HorizontalScrollView
                    android:id="@+id/timeSlotsScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/timeSlotsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp" />

                </HorizontalScrollView>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- Azərpoçt -->
            <LinearLayout
                android:id="@+id/optionPost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Azərpoçt şöbələrinə çatdırılma"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPostDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- may, "
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.56 ₼"
                                android:textSize="13sp"
                                android:textColor="#E91E8C" />

                        </LinearLayout>

                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/radioPost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E91E8C" />

                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- Özün götür -->
            <LinearLayout
                android:id="@+id/optionPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Təhvil məntəqəsindən özün götür"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPickupDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- may, "
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A1A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="pulsuz"
                                android:textSize="13sp"
                                android:textColor="#E91E8C" />

                        </LinearLayout>

                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/radioPickup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E91E8C" />

                </LinearLayout>

                <!-- Ünvan məlumatı -->
                <LinearLayout
                    android:id="@+id/pickupAddressLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPickupAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bakı şəh. Nərimanov r., Möhsün Sənani küç., 153"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnChangePickup"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Təhvil məntəqəsini dəyişdirin"
                        android:textColor="#E91E8C"
                        android:textSize="13sp"
                        android:backgroundTint="#FCE4EC"
                        app:cornerRadius="8dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
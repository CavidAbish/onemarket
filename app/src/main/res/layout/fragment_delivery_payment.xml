                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kuryer tərəfindən çatdırılan məhsulları təhvil alarkən zədələrin olub-olmamasını, məhsul dəstinin tam olmasını və ya işlək vəziyyətdə olub-olmamasını yoxlaya bilərsiniz." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />

                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="Birmarket-dən etdiyiniz sifarişləri aşağıdakı üsullarla ödəmək mümkündür:"
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:lineSpacingMultiplier="1.4" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bank kartı vasitəsi ilə onlayn" android:textSize="14sp" android:textColor="#1A1A1A" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bonus vasitəsi ilə onlayn" android:textSize="14sp" android:textColor="#1A1A1A" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bank kartı vasitəsi ilə məhsulu təhvil alarkən" android:textSize="14sp" android:textColor="#1A1A1A" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="İstənilən Birbank taksit kartı ilə hissəli ödəniş üsulu ilə" android:textSize="14sp" android:textColor="#1A1A1A" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kreditlə" android:textSize="14sp" android:textColor="#1A1A1A" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- SECTION: Sifariş ləğv edildikdə vəsaitlərin qaytarılması -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Sifariş ləğv edildikdə vəsaitlərin geri qaytarılması"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:lineSpacingMultiplier="1.3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

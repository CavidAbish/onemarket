<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            android:padding="6dp"
            android:contentDescription="Geri" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Çatdırılma və ödəmə"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ══════════════════════════════════════════ -->
            <!-- SECTION: Çatdırılma üsulları              -->
            <!-- ══════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="6dp"
                android:text="Çatdırılma üsulları"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:text="Birmarket-də aşağıda qeyd olunan çatdırılma üsulları mövcuddur:"
                android:textSize="14sp"
                android:textColor="#444444"
                android:lineSpacingMultiplier="1.4" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- ── 1.1 Kuryer planlı ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_delivery_truck"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:text="Kuryer ilə planlı çatdırılma (Bakı-Abşeron)"
                    android:textSize="18sp"
                    android:textColor="#1A1A1A"
                    android:lineSpacingMultiplier="1.3" />

                <!-- Bullet: Uyğun gün -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Uyğun gün" android:textSize="14sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sifarişi təsdiqləyən zaman sizə uyğun olan çatdırılma gününü seçə bilərsiniz." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bullet: Uyğun vaxt -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Uyğun vaxt" android:textSize="14sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Çatdırılma saat 9:00-dan saat 21:00-dək həyata keçirilir." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bullet: Pulsuz çatdırılma -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pulsuz çatdırılma" android:textSize="14sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Məbləği 50 ₼ və daha yuxarı olan bütün sifarişlər üçün" android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bullet: Ödənişli -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Məbləği 50 ₼-dan daha aşağı olan sifarişlərin çatdırılması ödənişlidir." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- ── 1.2 Kuryer ekspress ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_delivery_express"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:text="Kuryer ilə ekspress çatdırılma"
                    android:textSize="18sp"
                    android:textColor="#1A1A1A"
                    android:lineSpacingMultiplier="1.3" />

                <!-- Bullet: Həmin gün -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Çatdırılma həmin gün ərzində olacaq." android:textSize="14sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sifarişin rəsmiləşdirilmə anından etibarən 2 saat ərzində çatdırılır." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bullet: Qiymət -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ekspres çatdırılmanın qiymətini sifarişi yerləşdirərkən görmək mümkündür." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Bullet: Saat -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ekspres çatdırılma saat 9:00-dan saat 21:00-dək həyata keçirilir." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Bullet: Satıcıdan asılı -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ekspres çatdırılma satıcıdan asılı olaraq dəyişir." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- ── 1.3 Təhvil məntəqəsi ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_delivery_box"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:text="Təhvil məntəqələrinə çatdırılma"
                    android:textSize="18sp"
                    android:textColor="#1A1A1A"
                    android:lineSpacingMultiplier="1.3" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Məhsullar təhvil məntəqəsində 4 günə qədər müddətdə saxlanılır." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bu müddət ərzində götürülmədiyi təqdirdə sifariş ləğv edilir." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Böyük həcmli məhsulların çatdırılması həyata keçirilmir." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- ── 1.4 Azərpoçt ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_delivery_mail"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:text="Azərpoçt şöbələrinə çatdırılma"
                    android:textSize="18sp"
                    android:textColor="#1A1A1A"
                    android:lineSpacingMultiplier="1.3" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30 kq-dək məhsul çatdırılır" android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bütün Azərbaycan ərazisindəki şöbələrə çatdırılma mümkündür (Bakı və Sumqayıt istisna olmaqla)." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Böyük həcmli məhsulların çatdırılması həyata keçirilmir." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="#F5F5F5" />

            <!-- ══════════════════════════════════════════ -->
            <!-- SECTION: Həmişə pulsuz                    -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☝️"
                    android:textSize="36sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Həmişə pulsuz"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#7B2FF7" />

                <!-- Bullet: Kuryer planlı -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kuryer ilə planlı çatdırılma" android:textSize="14sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Məbləği 50 ₼-dən yuxarı olan bütün sifarişlər üçün." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bullet: Təhvil məntəqəsi -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Təhvil məntəqələrindən alınma" android:textSize="14sp" android:textStyle="bold" android:textColor="#1A1A1A" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Məbləği 5 ₼-dən yuxarı olan bütün sifarişlər üçün." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Məhsulun səhifəsində göstərilən çatdırılma üsulların istənilən növünü seçə bilərsiniz."
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- ══════════════════════════════════════════ -->
            <!-- SECTION: Sifarişin izlənilməsi            -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Sifarişin izlənilməsi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kuryer ilə planlı və ya ekspres çatdırılmanı seçdikdə sifarişin çatdırılmaya verilməsi və kuryerin hərəkəti ilə bağlı SMS bildirişlərini alacaqsınız." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Məhsulları özünüz götürəcəyiniz halda isə məhsullar təhvil məntəqəsinə və ya Azərpoçt şöbəsinə çatdırıldıqda bununla bağlı SMS bildirişi alacaqsınız." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- ══════════════════════════════════════════ -->
            <!-- SECTION: Çatdırılma vaxtının dəyişdirilməsi -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Çatdırılma vaxtının dəyişdirilməsi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <View android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_bullet_dot" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Əgər planlarınız dəyişib və çatdırılma vaxtını və ya ünvanını dəyişmək lazımdırsa, 915 nömrəsinə zəng vuraraq Birmarket Çağrı Mərkəzi ilə əlaqə saxlamağınız xahiş olunur." android:textSize="13sp" android:textColor="#555555" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

            <!-- ══════════════════════════════════════════ -->
            <!-- SECTION: Təhvil məntəqəsini necə tapmaq  -->
            <!-- ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
